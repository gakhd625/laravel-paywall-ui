{
    "name": "acme/laravel-access-gate",
    "description": "Access restriction and subscription enforcement for Laravel — UI lockout, route blocking, roles, and feature flags",
    "keywords": ["laravel", "paywall", "access-control", "subscription", "lockout", "middleware", "blade"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/config": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\AccessGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\AccessGate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acme\\AccessGate\\AccessGateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
